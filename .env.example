APP_NAME=headless-ecom
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8081
APP_VERSION=0.1.0

# Postgres (Docker Compose defaults - change in prod)
DB_HOST=db
DB_PORT=5432
DB_DATABASE=ecom
DB_USERNAME=ecom
DB_PASSWORD=ecom
DATABASE_URL=pgsql://ecom:ecom@db:5432/ecom

# Redis
REDIS_HOST=cache
REDIS_PORT=6379
REDIS_URL=redis://cache:6379

# Logging
LOG_LEVEL=debug
LOG_CHANNEL=stdout

# Auth placeholders (wire in Week-2, keep empty for Week-1)
JWT_SECRET=
JWT_TTL=900
REFRESH_TTL_DAYS=30

# CORS (comma-separated allowlist, tight in prod)
CORS_ALLOWED_ORIGINS=http://localhost:3000
