{
    "name": "headless-ecom/api",
    "description": "Production-grade headless ecommerce API - vanilla PHP MVC",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.3",
        "nikic/fast-route": "^1.3",
        "laminas/laminas-diactoros": "^3.0",
        "php-di/php-di": "^7.0",
        "monolog/monolog": "^3.0",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^1.12",
        "squizlabs/php_codesniffer": "^3.9",
        "fakerphp/faker": "^1.23"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --testsuite=Unit",
        "test-all": "phpunit",
        "analyse": "phpstan analyse app config routes public --level=8",
        "cs": "phpcs --standard=PSR12 app config routes public tests",
        "cs-fix": "phpcbf --standard=PSR12 app config routes public tests"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {}
    },
    "minimum-stability": "stable"
}
