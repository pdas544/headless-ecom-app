{
    "name": "headless-ecom/api",
    "description": "Production-grade headless ecommerce API - vanilla PHP MVC",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.3",
        "doctrine/dbal": "^4.0",
        "firebase/php-jwt": "^7.0",
        "illuminate/database": "^11.0",
        "laminas/laminas-diactoros": "^3.0",
        "monolog/monolog": "^3.0",
        "nikic/fast-route": "^1.3",
        "php-di/php-di": "^7.0",
        "predis/predis": "^2.2",
        "psr/http-server-handler": "^1",
        "psr/http-server-middleware": "^1",
        "robmorgan/phinx": "^0.16",
        "symfony/cache": "^7.0",
        "symfony/mailer": "^7.0",
        "symfony/rate-limiter": "^7.0",
        "symfony/validator": "^7.0",
        "twig/twig": "^3.10",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "phpstan/phpstan": "^1.12",
        "phpunit/phpunit": "^11.0",
        "squizlabs/php_codesniffer": "^3.9"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --testsuite=Unit",
        "test-all": "phpunit",
        "analyse": "phpstan analyse app config routes public --level=8",
        "cs": "phpcs --standard=PSR12 app config routes public tests",
        "cs-fix": "phpcbf --standard=PSR12 app config routes public tests"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {},
        "platform": {
            "php": "8.3.0"
        }
    },
    "minimum-stability": "stable"
}
